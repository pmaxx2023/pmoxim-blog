---
import Base from '../layouts/Base.astro';
import ChatWidget from '../components/chat/ChatWidget.astro';
---

<Base title="Ask Me About Product | pmoxim" description="Chat with an AI trained on Peni Moxim's product experience and philosophy.">
  <section class="wrap-narrow page-head">
    <p class="eyebrow">Ask Me</p>
    <h1 class="page-title">Ask me about <em>product.</em></h1>
    <p class="lede">
      Chat with an AI version of me. It knows my resume and how I think about building products. It is a quick way to get to know me before we talk.
    </p>
  </section>

  <section class="wrap-narrow">
    <ChatWidget />

    <div class="panel how">
      <h2>How this works</h2>
      <ul>
        <li>Claude powers it, using my real experience and views.</li>
        <li>It answers as me, in first person, based on what I have shared with it.</li>
        <li>For a real conversation, email me at <a href="mailto:pmoxim2018@gmail.com">pmoxim2018@gmail.com</a>.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .how {
    margin-top: 24px;
    padding: 24px;
  }
  .how h2 {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 10px;
  }
  .how ul {
    margin: 0;
    padding-left: 18px;
    list-style: disc;
    color: var(--muted);
    font-size: 15px;
    display: grid;
    gap: 6px;
  }
  .how a {
    color: var(--accent);
  }
</style>
