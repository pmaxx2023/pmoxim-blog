---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog | pmoxim" description="Short essays on product, healthcare rules and the frameworks Peni Moxim uses.">
  <section class="wrap-narrow page-head">
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Notes from the <em>build.</em></h1>
    <p class="lede">
      Short essays on product, healthcare rules and the frameworks I use to decide what to build.
    </p>
  </section>

  <section class="wrap-narrow">
    {sortedPosts.length > 0 ? (
      <div class="post-list">
        {sortedPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            href={`/blog/${post.slug}`}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="text-zinc-400">No posts yet. Check back soon.</p>
    )}
  </section>
</Base>

<style>
  .post-list {
    border-top: 1px solid var(--line);
  }
</style>
