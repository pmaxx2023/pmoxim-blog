---
import Base from '../layouts/Base.astro';
---

<Base title="pmoxim">
  <!-- Hero Section -->
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
      Hey, I'm <span class="text-blue-500">Peni Moxim</span>
    </h1>
    <p class="mt-6 text-xl text-zinc-300 max-w-2xl leading-relaxed">
      25+ years turning complex healthcare problems into products that work. From claims adjudication to FHIR APIs, I've built and shipped at every scale—prototypes in a weekend, enterprise platforms serving millions.
    </p>
    <p class="mt-4 text-lg text-zinc-400 max-w-2xl">
      Currently leading CMS-0057-F interoperability at Cigna. Building with AI since before it was cool.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="/resume"
        class="px-5 py-2.5 bg-blue-600 text-zinc-50 font-medium rounded-lg hover:bg-blue-500 transition-colors"
      >
        Resume
      </a>
      <a
        href="/projects"
        class="px-5 py-2.5 border border-zinc-700 text-zinc-400 font-medium rounded-lg hover:border-zinc-600 hover:text-zinc-50 transition-colors"
      >
        Projects
      </a>
      <a
        href="/ask"
        class="px-5 py-2.5 border border-zinc-700 text-zinc-400 font-medium rounded-lg hover:border-zinc-600 hover:text-zinc-50 transition-colors"
      >
        Ask Me About Product
      </a>
    </div>
  </section>
</Base>
